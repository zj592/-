.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #3b7cff, #6aa1ff);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-text {
  line-height: 110rpx;
  text-align: center;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 600;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
}

.user-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.admin-tag {
  margin-left: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.login-btn {
  background: #ffffff;
  color: #3b7cff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 34rpx;
  border-radius: 32rpx;
}

/* 菜单 */
.menu-card {
  padding: 8rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f2f4f8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 29rpx;
}

.menu-arrow {
  color: #c8ced9;
  font-size: 34rpx;
}

.menu-badge {
  background: #f2544b;
  color: #ffffff;
  font-size: 21rpx;
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
  margin-right: 12rpx;
}

.logout {
  text-align: center;
  color: #8a94a6;
  font-size: 27rpx;
  padding: 30rpx 0;
}

.footer-tip {
  text-align: center;
  color: #c8ced9;
  font-size: 22rpx;
  margin-top: 40rpx;
}

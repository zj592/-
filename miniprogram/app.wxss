/* ============ 全局基础样式 ============ */
page {
  background: #f4f6fa;
  font-size: 28rpx;
  color: #1f2733;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

/* ============ 卡片 ============ */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 39, 51, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2733;
}

.card-sub {
  font-size: 24rpx;
  color: #8a94a6;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-center {
  display: flex;
  align-items: center;
}

.divider {
  height: 1rpx;
  background: #eef1f6;
  margin: 24rpx 0;
}

/* ============ 标签 ============ */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  line-height: 1.6;
}

.tag-lost {
  color: #ff7043;
  background: #fff1ec;
}

.tag-found {
  color: #22c07d;
  background: #e9f9f1;
}

.tag-primary {
  color: #3b7cff;
  background: #eef3ff;
}

.tag-warning {
  color: #e9a13b;
  background: #fdf5e6;
}

.tag-success {
  color: #22c07d;
  background: #e9f9f1;
}

.tag-danger {
  color: #f2544b;
  background: #feeceb;
}

.tag-info {
  color: #8a94a6;
  background: #f1f3f7;
}

/* ============ 按钮 ============ */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: #3b7cff;
  color: #ffffff;
}

.btn-primary.disabled {
  background: #b9cdfb;
}

.btn-plain {
  background: #ffffff;
  color: #3b7cff;
  border: 1rpx solid #cfdcff;
}

.btn-ghost {
  background: #f1f3f7;
  color: #5b6473;
}

.btn-sm {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  display: inline-block;
}

/* ============ 表单 ============ */
.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 170rpx;
  color: #5b6473;
  font-size: 28rpx;
  flex-shrink: 0;
}

.form-label.required::before {
  content: "*";
  color: #f2544b;
  margin-right: 6rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2733;
}

.form-placeholder {
  color: #b6bdc9;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 20rpx 0;
}

.form-block {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef1f6;
}

/* ============ 空状态 ============ */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #b6bdc9;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.loading-more {
  text-align: center;
  font-size: 24rpx;
  color: #b6bdc9;
  padding: 24rpx 0 40rpx;
}

/* ============ 筛选栏 ============ */
.filter-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #5b6473;
  padding: 14rpx 0;
  border-radius: 12rpx;
}

.filter-tab.active {
  background: #eef3ff;
  color: #3b7cff;
  font-weight: 600;
}

.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-block;
  font-size: 25rpx;
  color: #5b6473;
  background: #ffffff;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  margin-right: 16rpx;
}

.chip.active {
  background: #3b7cff;
  color: #ffffff;
}

/* ============ 统计格子 ============ */
.stat-grid {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #3b7cff;
  display: block;
}

.stat-label {
  font-size: 23rpx;
  color: #8a94a6;
  margin-top: 8rpx;
  display: block;
}

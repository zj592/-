<view class="page">
  <view class="logo">🎒</view>
  <view class="title">校园失物招领</view>
  <view class="subtitle">丢了东西 / 捡到东西，都来这里</view>

  <view class="filter-tabs mode-tabs">
    <view class="filter-tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
    <view class="filter-tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
  </view>

  <!-- 微信一键登录 -->
  <view class="wx-login {{submitting ? 'disabled' : ''}}" bindtap="wxLogin">
    <text class="wx-icon">💬</text>
    <text>微信一键登录</text>
  </view>
  <view class="wx-tip">首次登录自动创建账号，不需要记密码</view>

  <view class="or-line">
    <text class="or-text">或使用账号密码</text>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="form-label required">账号</text>
      <input
        class="form-input"
        value="{{form.username}}"
        data-field="username"
        maxlength="20"
        placeholder="4-20 位字母数字"
        placeholder-class="form-placeholder"
        bindinput="onInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label required">密码</text>
      <input
        class="form-input"
        value="{{form.password}}"
        data-field="password"
        password
        maxlength="20"
        placeholder="6-20 位"
        placeholder-class="form-placeholder"
        bindinput="onInput"
      />
    </view>

    <block wx:if="{{mode === 'register'}}">
      <view class="form-item">
        <text class="form-label required">昵称</text>
        <input
          class="form-input"
          value="{{form.nickname}}"
          data-field="nickname"
          maxlength="20"
          placeholder="展示给其他同学看"
          placeholder-class="form-placeholder"
          bindinput="onInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input
          class="form-input"
          value="{{form.phone}}"
          data-field="phone"
          type="number"
          maxlength="11"
          placeholder="选填"
          placeholder-class="form-placeholder"
          bindinput="onInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">常活动区域</text>
        <input
          class="form-input"
          value="{{form.campus}}"
          data-field="campus"
          maxlength="30"
          placeholder="例：东区宿舍 / 图书馆"
          placeholder-class="form-placeholder"
          bindinput="onInput"
        />
      </view>
    </block>
  </view>

  <view class="btn btn-primary submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
    {{mode === 'login' ? '登录' : '注册并登录'}}
  </view>

  <view class="demo-tip">
    <text>演示账号：student / 123456（普通用户）、admin / admin123（管理员）</text>
    <text class="demo-fill" bindtap="fillDemo">一键填入</text>
  </view>
</view>

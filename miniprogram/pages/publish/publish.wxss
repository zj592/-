.page {
  padding: 24rpx 24rpx 140rpx;
}

/* 类型切换 */
.type-switch {
  display: flex;
  margin-bottom: 24rpx;
}

.type-item {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
  margin-right: 24rpx;
  border: 2rpx solid transparent;
}

.type-item:last-child {
  margin-right: 0;
}

.type-item.active-lost {
  border-color: #ff7043;
  background: #fff6f2;
}

.type-item.active-found {
  border-color: #22c07d;
  background: #f0fbf6;
}

.type-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.type-desc {
  display: block;
  font-size: 22rpx;
  color: #98a1b0;
  margin-top: 8rpx;
}

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 分类 */
.category-list {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  font-size: 25rpx;
  color: #5b6473;
  background: #f4f6fa;
  border-radius: 30rpx;
  padding: 12rpx 30rpx;
  margin: 0 18rpx 18rpx 0;
}

.category-item.active {
  background: #3b7cff;
  color: #ffffff;
}

/* picker */
.picker-value {
  font-size: 28rpx;
  color: #3b7cff;
  margin-right: 32rpx;
}

/* 图片 */
.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 20rpx 20rpx 0;
}

.image-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f1f3f7;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 22rpx;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #d3dae6;
  color: #b6bdc9;
  font-size: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-text {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.tip {
  font-size: 23rpx;
  color: #98a1b0;
  text-align: center;
  margin: 10rpx 0 30rpx;
}

.submit-btn {
  box-shadow: 0 8rpx 20rpx rgba(59, 124, 255, 0.28);
}
